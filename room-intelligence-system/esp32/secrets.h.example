// secrets.h.example
//
// Copy this file to "secrets.h" and fill in your own real values.
// secrets.h is listed in .gitignore, it will NEVER be committed to git.

#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID       "your-wifi-name"
#define WIFI_PASSWORD   "your-wifi-password"

// Google Apps Script Web App URL (see /apps-script/Code.gs.example)
#define SHEETS_URL      "https://script.google.com/macros/s/XXXXXXXXXXXX/exec"

// Shared secret, must match SECRET_KEY in Code.gs exactly
#define SHARED_SECRET   "choose-a-long-random-string"

#endif
