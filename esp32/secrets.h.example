// secrets.h.example
//
// Copy this file to "secrets.h" and fill in your own values.
// secrets.h is listed in .gitignore and is never committed.

#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID       "your-wifi-name"
#define WIFI_PASSWORD   "your-wifi-password"

// Google Apps Script web app URL (Deploy → Web app in apps-script/Code_v2.gs)
#define SHEETS_URL      "https://script.google.com/macros/s/XXXXXXXXXXXX/exec"

// Must match the SECRET_KEY Script property exactly
#define SHARED_SECRET   "choose-a-long-random-string"

#endif
